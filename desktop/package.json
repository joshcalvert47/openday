{
  "name": "openday-desktop",
  "productName": "OpenDay",
  "version": "0.1.0",
  "description": "OpenDay desktop app: your self-hosted calendar with notifications in the background.",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "org.openday.desktop",
    "productName": "OpenDay",
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "icons/**"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icons/icon.png",
      "category": "Office",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icons/icon.png",
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "desktopName": "openday.desktop"
}
